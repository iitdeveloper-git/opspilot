# OpsPilot Environment Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALERT_CHAT_ID=-1001234567890

# AI Copilot Provider (openai / anthropic / gemini / ollama)
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=http://localhost:11434/v1  # For Ollama or private LLM

# Node / Server Name
OPSPILOT_SERVER_NAME=ovh-vps-production
