# OpsPilot Environment Configuration

# ─────────────────────────────────────────────────────────────
# TELEGRAM BOT
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# REQUIRED in production: comma-separated Telegram User IDs that are allowed
# to control this bot. Find your ID via @userinfobot on Telegram.
# WARNING: If this is empty and OPSPILOT_AUTH_MODE is not set to "development",
#          OpsPilot will DENY ALL incoming requests (fail-closed).
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

TELEGRAM_ALERT_CHAT_ID=-1001234567890

# ─────────────────────────────────────────────────────────────
# AUTH MODE
# ─────────────────────────────────────────────────────────────
# "production" (default): deny all requests if TELEGRAM_ALLOWED_USER_IDS is empty.
# "development": allow ALL users — NEVER use this value in production.
OPSPILOT_AUTH_MODE=production

# ─────────────────────────────────────────────────────────────
# AI COPILOT PROVIDER (openai / anthropic / gemini / ollama)
# ─────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=http://localhost:11434/v1  # For Ollama or private LLM endpoint

# ─────────────────────────────────────────────────────────────
# NODE / SERVER IDENTITY
# ─────────────────────────────────────────────────────────────
OPSPILOT_SERVER_NAME=ovh-vps-production
LOG_LEVEL=INFO
