# ─────────────────────────────────────────────────────────────────────────────
# OpsPilot Manual Deploy Config
# Copy this file to .deploy.env and fill in your real values.
# .deploy.env is in .gitignore — NEVER commit it.
# ─────────────────────────────────────────────────────────────────────────────

# VPS connection (required)
DEPLOY_HOST=192.0.2.1  # Replace with your VPS IP or hostname
DEPLOY_USER=ubuntu

# SSH private key path (optional — leave blank if ssh-agent is loaded)
# SSH_KEY_PATH=~/.ssh/opspilot_deploy_key

# GHCR auth (optional — needed if the GHCR package is private)
GITHUB_ACTOR=iitdeveloper-git
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx  # GitHub PAT with read:packages scope

# Image tag to deploy (optional — can also pass as: ./deploy_manual.sh v0.1.0)
# IMAGE_TAG=latest
