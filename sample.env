# OpsPilot Environment Configuration Template
# Copy to .env and configure for your environment

# ── General Server Settings ──────────────────────────────────────────────────
SERVER_NAME="node-01"
LOG_LEVEL="INFO"

# ── Web Command Center ────────────────────────────────────────────────────────
OPSPILOT_WEB_ENABLED=true
OPSPILOT_WEB_HOST=0.0.0.0
OPSPILOT_WEB_PORT=8080
OPSPILOT_ADMIN_PASSWORD="change_me_to_a_secure_master_password"

# ── Telegram ChatOps & Alerts ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_ALERT_CHAT_ID="-1001234567890"
TELEGRAM_ALLOWED_USERS="123456789,987654321"

# ── AI Diagnostic Copilot & RCA ──────────────────────────────────────────────
# Supported: gemini, groq, openai, deepseek, ollama
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
AI_ENDPOINT=""

# ── Monitoring & Auto-Prune Engine ────────────────────────────────────────────
MONITORING_INTERVAL_SECONDS=60
CPU_THRESHOLD_PERCENT=85.0
RAM_THRESHOLD_PERCENT=90.0
DISK_THRESHOLD_PERCENT=90.0
AUTO_PRUNE_ENABLED=true
AUTO_PRUNE_INTERVAL_HOURS=24
AUTO_PRUNE_UNTIL_HOURS=168

# ── SSL & HTTP Probe Targets (Comma-separated) ────────────────────────────────
SSL_DOMAINS="example.com,api.example.com"
ENDPOINT_PROBES="https://example.com,https://api.example.com/health"
